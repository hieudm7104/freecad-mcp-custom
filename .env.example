# Copy to .env and fill in before `docker compose up`.

# Required. Clients must send this as `X-API-Key: <value>` or
# `Authorization: Bearer <value>` when calling the MCP server over HTTP.
# Generate one with: openssl rand -hex 32
FREECAD_MCP_API_KEY=

# Host port the MCP server is published on.
MCP_PORT=8000
