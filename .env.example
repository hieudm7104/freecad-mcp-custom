# Copy to .env and fill in before `docker compose up`.

# Required. Clients must send this as `X-API-Key: <value>` or
# `Authorization: Bearer <value>` when calling the MCP server over HTTP.
# Generate one with: openssl rand -hex 32
FREECAD_MCP_API_KEY=

# Host port the MCP server is published on.
MCP_PORT=8000

# Optional. Set this to enable the OAuth 2.1 (Authorization Code + PKCE)
# shim at /oauth/authorize and /oauth/token, for MCP clients (e.g. ChatGPT's
# Connector UI) that only support "no auth" or real OAuth — never a plain
# static API key. Logging in still just means typing FREECAD_MCP_API_KEY
# into the shim's one-field login page; see src/freecad_mcp/oauth.py.
# Any string works as long as it matches the "OAuth Client ID" you register
# on the client side. Leave unset to disable the shim (X-API-Key/Bearer
# auth with the raw key keeps working either way).
FREECAD_MCP_OAUTH_CLIENT_ID=

# blender-mcp (docker/blender + docker/blender-mcp) — same shape as the
# FreeCAD settings above, for the separate live-Blender MCP server.
BLENDER_MCP_API_KEY=
BLENDER_MCP_OAUTH_CLIENT_ID=
BLENDER_MCP_PORT=8002

# MinIO — persistent storage for saved FreeCAD documents and Blender scenes
# (without it, both apps keep everything in RAM only and a container restart
# loses the work). Both MCP servers reuse these as their S3 credentials, and
# their save/load tools are only registered when they're set.
# Generate a password with: openssl rand -hex 20
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=cad
# Published on 127.0.0.1 only (see docker-compose.yml).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
